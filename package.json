{
  "name": "floating-todo",
  "productName": "FloatingTodo",
  "version": "0.5.9",
  "description": "Windows 桌面代辦事項懸浮視窗",
  "author": "open900418",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.desktop.floating-todo",
    "productName": "FloatingTodo",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "picker.html",
      "picker-preload.js",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "桌面代辦",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "FloatingTodo-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "Tsukiinuhibi",
      "repo": "FloatingTodo",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "nodemailer": "^10.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tsukiinuhibi/FloatingTodo.git"
  }
}
